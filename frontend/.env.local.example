# CopilotKit provider API keys — configure any providers you want available in the model selector.
# BuiltInAgent resolves the correct key per provider from these env vars.

# Google Gemini (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=your-google-ai-studio-key
# Alternative name:
# GEMINI_API_KEY=your-google-ai-studio-key

# OpenAI (https://platform.openai.com/api-keys)
# OPENAI_API_KEY=sk-...

# Anthropic (https://console.anthropic.com/)
# ANTHROPIC_API_KEY=sk-ant-...

# MiniMax
# MINIMAX_API_KEY=your-minimax-key
# MINIMAX_BASE_URL=https://api.minimaxi.com/v1

# Default CopilotKit model (provider/model format, e.g. google/gemini-2.5-flash or openai/gpt-4o)
# Available models are fetched at runtime from configured provider APIs + CopilotKit built-ins.
# Server agent reads COPILOT_MODEL; client default reads NEXT_PUBLIC_COPILOT_MODEL — set both to the same value:
COPILOT_MODEL=google/gemini-3.5-flash-lite
NEXT_PUBLIC_COPILOT_MODEL=google/gemini-3.5-flash-lite

# Client-side Express API (existing storefront)
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Server-side tool calls from /api/copilotkit (OpenAPI paths include /api/...)
BACKEND_BASE_URL=http://localhost:5000
# Legacy alias (still supported as fallback):
# BACKEND_API_URL=http://localhost:5000/api
