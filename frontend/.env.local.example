# LLM for CopilotKit BuiltInAgent + generate_a2ui sub-LLM (server-only)
OPENAI_API_KEY=sk-your-openai-key

# Optional model override (default: openai/gpt-4o-mini)
# COPILOT_MODEL=openai/gpt-4o-mini

# Client-side Express API (existing storefront)
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Server-side tool calls from /api/copilotkit
BACKEND_API_URL=http://localhost:5000/api
