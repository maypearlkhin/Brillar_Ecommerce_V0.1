# CopilotKit provider API keys — configure any providers you want available in the model selector.
# BuiltInAgent resolves the correct key per provider from these env vars.

# Google Gemini (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=your-google-ai-studio-key
# Alternative name:
# GEMINI_API_KEY=your-google-ai-studio-key

# OpenAI (https://platform.openai.com/api-keys)
# OPENAI_API_KEY=sk-...
# Free key check (no chat tokens): node scripts/validate-provider-keys.mjs
# Or with dev server running: GET http://localhost:3000/api/copilot/providers/validate

# Anthropic (https://console.anthropic.com/)
# ANTHROPIC_API_KEY=sk-ant-...

# MiniMax
# MINIMAX_API_KEY=your-minimax-key
# MINIMAX_BASE_URL=https://api.minimaxi.com/v1

# Default CopilotKit model (provider/model format, e.g. google/gemini-2.5-flash or openai/gpt-4o)
# Available models are fetched at runtime from configured provider APIs + CopilotKit built-ins.
# Server agent reads COPILOT_MODEL; client default reads NEXT_PUBLIC_COPILOT_MODEL — set both to the same value:
COPILOT_MODEL=google/gemini-3.5-flash-lite
NEXT_PUBLIC_COPILOT_MODEL=google/gemini-3.5-flash-lite

# --- Copilot BuiltInAgent runtime (same base for ALL models) ---
COPILOT_AGENT_MAX_STEPS=14
COPILOT_AGENT_MAX_OUTPUT_TOKENS=16384
# 4096 is too small for generate_a2ui product grids (finishReason: length →
# RUN_FINISHED while the A2UI tool call is still open).
# OpenAI/Anthropic also disable parallel tool calls in code, but GPT-5.x may ignore
# that flag. BuiltInAgent factory mode hides generate_a2ui via AI SDK prepareStep /
# activeTools until a data tool returns (see lib/copilot/agentStream.ts).

# Optional OpenAI reasoning API flags — only applied to openai/gpt-5* and openai/o* models:
COPILOT_AGENT_OPENAI_REASONING_EFFORT=none
COPILOT_AGENT_OPENAI_REASONING_MODE=standard
COPILOT_AGENT_OPENAI_REASONING_CONTEXT=current_turn

# Optional per-model JSON overrides (highest priority). Keys are full model ids.
# COPILOT_AGENT_MODEL_OVERRIDES={"openai/gpt-5.6-luna":{"reasoningEffort":"none"}}

# Client-side Express API (existing storefront)
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Server-side tool calls from /api/copilotkit (OpenAPI paths include /api/...)
BACKEND_BASE_URL=http://localhost:5000
# Legacy alias (still supported as fallback):
# BACKEND_API_URL=http://localhost:5000/api
