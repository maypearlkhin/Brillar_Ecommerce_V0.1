# Google Gemini (free tier via AI Studio: https://aistudio.google.com/apikey)
# Used by CopilotKit BuiltInAgent + generate_a2ui sub-LLM (server-only)
GOOGLE_API_KEY=your-google-ai-studio-key
# Alternative name (Google docs often use this):
# GEMINI_API_KEY=your-google-ai-studio-key

# Optional model override (default: google/gemini-2.5-flash)
# Other free-tier options: google/gemini-2.5-flash-lite
# COPILOT_MODEL=google/gemini-2.5-flash

# Client-side Express API (existing storefront)
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Server-side tool calls from /api/copilotkit (OpenAPI paths include /api/...)
BACKEND_BASE_URL=http://localhost:5000
# Legacy alias (still supported as fallback):
# BACKEND_API_URL=http://localhost:5000/api
