{
  "openapi": "3.0.3",
  "info": {
    "title": "Brillar E-Commerce Customer — Account, Cart, Checkout & Orders API",
    "description": "Authenticated customer storefront endpoints. Used by the A2UI shopping assistant (`get_profile`, `get_cart`, `add_to_cart`, `update_cart_item`, `remove_from_cart`, `get_order_history`, `get_order_details`, `buy_again` tools).\n\n**Authentication:** All endpoints except `POST /api/auth/register` and `POST /api/auth/login` require `Authorization: Bearer <JWT>`. Obtain a token from register or login.\n\n**Checkout:** Places an order from the customer's **existing cart**. Populate the cart first via `POST /api/cart`. The assistant directs users to `/checkout` for payment in chat; this endpoint is for the web checkout flow.\n\n**Response envelope:** `{ success, message, data }` on success, or `{ success, message, errors }` on failure.",
    "version": "1.0.0",
    "contact": {
      "name": "Brillar API Support",
      "email": "api-support@brillarbroadband.com"
    }
  },
  "servers": [
    {
      "url": "http://localhost:5000",
      "description": "Local development"
    }
  ],
  "paths": {
    "/api/auth/register": {
      "post": {
        "summary": "Register Customer",
        "description": "Create a new customer account and receive a JWT. Email must be from an allowed domain (`ecommerce.com` or `gmail.com`).",
        "tags": ["Auth"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RegisterBody" },
              "example": {
                "name": "Jane Customer",
                "email": "jane@gmail.com",
                "password": "secret123",
                "phone": "+6591234567"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Registration successful",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthResponse" }
              }
            }
          },
          "400": {
            "description": "Validation error or email already registered",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "summary": "Login",
        "description": "Authenticate with email and password. Returns a JWT for subsequent requests.",
        "tags": ["Auth"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoginBody" },
              "example": {
                "email": "jane@gmail.com",
                "password": "secret123"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthResponse" }
              }
            }
          },
          "401": {
            "description": "Invalid credentials",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "summary": "Get Profile",
        "description": "Get the logged-in customer profile. Copilot tool: `get_profile`.",
        "tags": ["Account"],
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Profile fetched successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ProfileResponse" }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "404": {
            "description": "User not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Update Profile",
        "description": "Update name or phone for the logged-in customer.",
        "tags": ["Account"],
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateProfileBody" },
              "example": {
                "name": "Jane Customer",
                "phone": "+6591234567"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Profile updated",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ProfileResponse" }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/api/products/{id}/like": {
      "post": {
        "summary": "Toggle Product Like",
        "description": "Like or unlike a product for the logged-in customer.",
        "tags": ["Account"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "MongoDB `_id` of the product.",
            "schema": { "type": "string", "example": "664a1b2c3d4e5f6a7b8c9d0b" }
          }
        ],
        "responses": {
          "200": {
            "description": "Like toggled successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/LikeToggleResponse" }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "404": {
            "description": "Product not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/api/cart": {
      "get": {
        "summary": "Get Cart",
        "description": "Get the current shopping cart for the logged-in customer. Copilot tool: `get_cart`.",
        "tags": ["Cart"],
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Cart fetched successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CartResponse" }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Add to Cart",
        "description": "Adds a product to the cart (or increases quantity if already present). Confirm with the user before calling. Copilot tool: `add_to_cart`.",
        "tags": ["Cart"],
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AddToCartBody" },
              "example": {
                "productId": "664a1b2c3d4e5f6a7b8c9d0b",
                "quantity": 1
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Item added to cart",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CartResponse" }
              }
            }
          },
          "400": {
            "description": "Product unavailable or insufficient stock",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Clear Cart",
        "description": "Removes all items from the customer's cart.",
        "tags": ["Cart"],
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Cart cleared",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CartResponse" }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/api/cart/{productId}": {
      "put": {
        "summary": "Update Cart Item Quantity",
        "description": "Updates the quantity of a cart line item. Confirm with the user before calling. Copilot tool: `update_cart_item`. Setting quantity to 0 or below removes the item.",
        "tags": ["Cart"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "productId",
            "in": "path",
            "required": true,
            "description": "MongoDB `_id` of the product in the cart.",
            "schema": { "type": "string", "example": "664a1b2c3d4e5f6a7b8c9d0b" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateCartItemBody" },
              "example": { "quantity": 2 }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Cart updated",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CartResponse" }
              }
            }
          },
          "400": {
            "description": "Cart or item not found, or insufficient stock",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Remove from Cart",
        "description": "Removes a product from the cart. Confirm with the user before calling. Copilot tool: `remove_from_cart`.",
        "tags": ["Cart"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "productId",
            "in": "path",
            "required": true,
            "description": "MongoDB `_id` of the product to remove.",
            "schema": { "type": "string", "example": "664a1b2c3d4e5f6a7b8c9d0b" }
          }
        ],
        "responses": {
          "200": {
            "description": "Item removed from cart",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CartResponse" }
              }
            }
          },
          "400": {
            "description": "Item not in cart",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/api/checkout": {
      "post": {
        "summary": "Checkout",
        "description": "Places an order from the customer's existing cart. Requires delivery address and payment method. Used by the web checkout page; the chat assistant directs users to `/checkout` instead of calling this in conversation.",
        "tags": ["Checkout"],
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CheckoutBody" },
              "example": {
                "deliveryAddress": {
                  "fullName": "Jane Customer",
                  "phone": "+6591234567",
                  "addressLine1": "123 Orchard Road",
                  "city": "Singapore",
                  "postalCode": "238858"
                },
                "paymentMethod": "Prepaid"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Order placed successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CheckoutResponse" }
              }
            }
          },
          "400": {
            "description": "Empty cart, invalid address, or stock error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/api/orders": {
      "get": {
        "summary": "Get Order History",
        "description": "Paginated order history for the logged-in customer. Copilot tool: `get_order_history`.",
        "tags": ["Orders"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "minimum": 1, "default": 1, "example": 1 }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "minimum": 1, "default": 10, "example": 10 }
          }
        ],
        "responses": {
          "200": {
            "description": "Orders fetched successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/OrderListResponse" }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/api/orders/{id}": {
      "get": {
        "summary": "Get Order Details",
        "description": "Single order by MongoDB `_id`. Copilot tool: `get_order_details`.",
        "tags": ["Orders"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "MongoDB `_id` of the order.",
            "schema": { "type": "string", "example": "674a1b2c3d4e5f6a7b8c9d0e" }
          }
        ],
        "responses": {
          "200": {
            "description": "Order fetched successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/OrderDetailResponse" }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "404": {
            "description": "Order not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/api/orders/{id}/buy-again": {
      "post": {
        "summary": "Buy Again",
        "description": "Re-add items from a past order to the cart. Confirm with the user before calling. Copilot tool: `buy_again`.",
        "tags": ["Orders"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "MongoDB `_id` of the order to buy again.",
            "schema": { "type": "string", "example": "674a1b2c3d4e5f6a7b8c9d0e" }
          }
        ],
        "responses": {
          "200": {
            "description": "Items added to cart",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CartResponse" }
              }
            }
          },
          "400": {
            "description": "Order not found or items unavailable",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT from POST /api/auth/login or POST /api/auth/register. Send as Authorization: Bearer <token>."
      }
    },
    "schemas": {
      "RegisterBody": {
        "type": "object",
        "required": ["name", "email", "password"],
        "properties": {
          "name": { "type": "string" },
          "email": {
            "type": "string",
            "format": "email",
            "description": "Must use ecommerce.com or gmail.com domain."
          },
          "password": {
            "type": "string",
            "minLength": 6
          },
          "phone": { "type": "string" }
        }
      },
      "LoginBody": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": { "type": "string", "format": "email" },
          "password": { "type": "string" }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "email": { "type": "string" },
          "phone": { "type": "string" },
          "role": {
            "type": "string",
            "enum": ["customer", "supplier", "admin"]
          },
          "isActive": { "type": "boolean" },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "AuthData": {
        "type": "object",
        "properties": {
          "user": { "$ref": "#/components/schemas/User" },
          "token": {
            "type": "string",
            "description": "JWT for Authorization: Bearer header."
          },
          "supplierStatus": {
            "type": "string",
            "nullable": true,
            "description": "Present on login for supplier accounts only."
          }
        }
      },
      "AuthResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "message": { "type": "string" },
          "data": { "$ref": "#/components/schemas/AuthData" }
        }
      },
      "ProfileResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "message": { "type": "string" },
          "data": { "$ref": "#/components/schemas/User" }
        }
      },
      "UpdateProfileBody": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "phone": { "type": "string" }
        }
      },
      "LikeToggleData": {
        "type": "object",
        "properties": {
          "liked": { "type": "boolean" },
          "likeCount": { "type": "integer" }
        }
      },
      "LikeToggleResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "message": { "type": "string" },
          "data": { "$ref": "#/components/schemas/LikeToggleData" }
        }
      },
      "AddToCartBody": {
        "type": "object",
        "required": ["productId"],
        "properties": {
          "productId": {
            "type": "string",
            "description": "MongoDB `_id` of the product to add."
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "default": 1
          }
        }
      },
      "UpdateCartItemBody": {
        "type": "object",
        "required": ["quantity"],
        "properties": {
          "quantity": {
            "type": "integer",
            "minimum": 0,
            "description": "New quantity. Values ≤ 0 remove the item."
          }
        }
      },
      "CheckoutBody": {
        "type": "object",
        "required": ["deliveryAddress", "paymentMethod"],
        "properties": {
          "deliveryAddress": { "$ref": "#/components/schemas/DeliveryAddress" },
          "paymentMethod": {
            "type": "string",
            "description": "Payment method identifier (e.g. `Prepaid`).",
            "example": "Prepaid"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": false },
          "message": { "type": "string" },
          "errors": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      },
      "Pagination": {
        "type": "object",
        "properties": {
          "page": { "type": "integer" },
          "limit": { "type": "integer" },
          "total": { "type": "integer" },
          "pages": { "type": "integer" }
        }
      },
      "SupplierRef": {
        "type": "object",
        "properties": {
          "_id": { "type": "string" },
          "storeName": { "type": "string" },
          "slug": { "type": "string" }
        }
      },
      "ProductRef": {
        "type": "object",
        "properties": {
          "_id": { "type": "string" },
          "name": { "type": "string" },
          "slug": { "type": "string" },
          "imageUrls": {
            "type": "array",
            "items": { "type": "string" }
          },
          "status": {
            "type": "string",
            "enum": ["active", "inactive", "out_of_stock"]
          },
          "stockQuantity": { "type": "integer" }
        }
      },
      "CartItem": {
        "type": "object",
        "properties": {
          "productId": { "$ref": "#/components/schemas/ProductRef" },
          "supplierId": { "$ref": "#/components/schemas/SupplierRef" },
          "quantity": { "type": "integer", "minimum": 1 },
          "unitPrice": { "type": "number" }
        }
      },
      "Cart": {
        "type": "object",
        "properties": {
          "_id": { "type": "string" },
          "customerId": { "type": "string" },
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/CartItem" }
          },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "CartResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "message": { "type": "string" },
          "data": { "$ref": "#/components/schemas/Cart" }
        }
      },
      "DeliveryAddress": {
        "type": "object",
        "required": ["fullName", "phone", "addressLine1", "city"],
        "properties": {
          "fullName": { "type": "string" },
          "phone": { "type": "string" },
          "addressLine1": { "type": "string" },
          "addressLine2": { "type": "string" },
          "city": { "type": "string" },
          "stateRegion": { "type": "string" },
          "postalCode": { "type": "string" },
          "notes": { "type": "string" }
        }
      },
      "OrderItem": {
        "type": "object",
        "properties": {
          "productId": { "type": "string" },
          "nameSnapshot": { "type": "string" },
          "skuSnapshot": { "type": "string" },
          "unitPrice": { "type": "number" },
          "unitCost": { "type": "number" },
          "quantity": { "type": "integer" },
          "lineTotal": { "type": "number" }
        }
      },
      "SupplierOrder": {
        "type": "object",
        "properties": {
          "_id": { "type": "string" },
          "supplierId": { "$ref": "#/components/schemas/SupplierRef" },
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/OrderItem" }
          },
          "subtotal": { "type": "number" },
          "fulfillmentStatus": {
            "type": "string",
            "enum": ["pending", "confirmed", "processing", "shipped", "delivered", "cancelled"]
          }
        }
      },
      "Order": {
        "type": "object",
        "properties": {
          "_id": { "type": "string" },
          "orderNumber": { "type": "string" },
          "customerId": { "type": "string" },
          "supplierOrders": {
